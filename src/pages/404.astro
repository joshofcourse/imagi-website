---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout title="Page not found">
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">404 error</Badge>
        <h1 class="text-display-l">Sorry, we couldn’t find that page.</h1>
        <div class="hero_lead text-body-l">
          <p>The page you were looking for at this URL doesn’t exist or has moved.</p>
        </div>
        <div class="hero_actions">
          <Button href="/" size="l" arrow>Go to the home page</Button>
          <Button href="/contact" variant="outline" size="l">Contact us</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
