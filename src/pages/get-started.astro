---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import SchoolLogos from '../components/SchoolLogos.astro';
import StudentProjects from '../components/StudentProjects.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Get Started with imagi"
  description="Set up your imagi account and start your first project. A few minutes to sign up, with help available if you get stuck along the way."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">Get started</Badge>
        <h1 class="text-display-l">Get started with imagi in four steps</h1>
        <div class="hero_lead text-body-l">
          <p>
            imagi gives students safe access to real-world AI tools through guided projects and teacher-ready lessons, so they build skills,
            not shortcuts.
          </p>
        </div>
        <div class="hero_meta">
          <Badge tone="neutral" size="m">No coding experience needed</Badge>
          <Badge tone="neutral" size="m">Free for teachers</Badge>
        </div>
        <div class="hero_actions">
          <Button href="https://edu.imagilabs.com/" size="l" arrow>Join free</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">How it works</Badge>
        <h2 class="text-display-s">From first idea to future-ready skills</h2>
        <div class="section-header_intro text-body-l">
          <p>
            imagi gives students a safe place to think, build and create with real-world AI tools, and practice skills they’ll use in any
            career.
          </p>
        </div>
      </header>

      <div class="steps">
        <div class="split">
          <div class="split_text">
            <Badge tone="brand" size="m">Step 1</Badge>
            <h3 class="text-heading-l">Build something yourself</h3>
            <p class="text-body-l text-secondary">
              Sign up and make your first project before your students do. You’ll see exactly what they’ll experience, and how much they can
              create.
            </p>
            <div class="tags">
              <Badge tone="neutral">Free for teachers</Badge>
            </div>
          </div>
          <div class="split_media">
            <img class="split_image steps_image"
              src="/images/get-started/teacher-laptop.webp"
              alt="A smiling teacher working on a laptop at a table with her high school students"
              loading="lazy"
            />
          </div>
        </div>

        <div class="split">
          <div class="split_text">
            <Badge tone="brand" size="m">Step 2</Badge>
            <h3 class="text-heading-l">Create your classroom</h3>
            <p class="text-body-l text-secondary">
              Create a classroom and add your students. You can see every prompt they write, and there’s no unnecessary data sharing.
            </p>
            <p class="text-body-s-medium">Skills they practice</p>
            <div class="tags">
              <Badge tone="neutral">Safe AI use</Badge>
              <Badge tone="neutral">Digital responsibility</Badge>
            </div>
          </div>
          <div class="split_media split_media--first">
            <img class="split_image steps_image" src="/images/home/broll.00_43_12_07.still035-1.jpg" alt="A teacher smiling at her laptop in a classroom" loading="lazy" />
          </div>
        </div>

        <div class="split">
          <div class="split_text">
            <Badge tone="brand" size="m">Step 3</Badge>
            <h3 class="text-heading-l">Students solve real problems</h3>
            <p class="text-body-l text-secondary">
              Assign a lesson with slides and a lesson plan included. Students start with a problem they care about, then plan, prompt,
              test, fix what breaks and explain their thinking.
            </p>
            <p class="text-body-s-medium">Skills they practice</p>
            <div class="tags">
              <Badge tone="neutral">Problem-solving</Badge>
              <Badge tone="neutral">Critical thinking</Badge>
              <Badge tone="neutral">Communication</Badge>
            </div>
          </div>
          <div class="split_media">
            <img class="split_image steps_image"
              src="/images/get-started/students-project.webp"
              alt="Two high school students at a laptop, one pointing at their project on screen"
              loading="lazy"
            />
          </div>
        </div>

        <div class="split">
          <div class="split_text">
            <Badge tone="brand" size="m">Step 4</Badge>
            <h3 class="text-heading-l">See what they build</h3>
            <p class="text-body-l text-secondary">
              Study tools, websites, games and digital portfolios they’re proud to show. You can follow every project and their progress in
              one place.
            </p>
            <p class="text-body-s-medium">Skills they practice</p>
            <div class="tags">
              <Badge tone="neutral">Creativity</Badge>
              <Badge tone="neutral">Iteration</Badge>
              <Badge tone="neutral">Presenting their work</Badge>
            </div>
          </div>
          <div class="split_media split_media--first">
            <img class="split_image steps_image"
              src="/images/get-started/student-career-quest.webp"
              alt="A high school student smiling as she holds up a laptop showing Career Quest, a career discovery game she built"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <div class="closer">
        <p class="text-heading-m">Skills for any future career start in your classroom.</p>
        <Button href="https://edu.imagilabs.com/" size="l" arrow>Join free</Button>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <SchoolLogos />
    </div>
  </section>

  <section class="section section--muted">
    <div class="section_inner">
      <header class="projects-header">
        <div class="projects-header_text">
          <h2 class="text-display-s">Real student projects</h2>
          <p class="projects-header_intro text-body-l">Try some of our favorite student-coded projects made inside the imagi tool.</p>
        </div>
        <div class="madewith">
          <p class="madewith_label text-body-s-medium">Made with</p>
          <img class="madewith_logo" src="/brand/lovable-wordmark-dark.svg" alt="Lovable" width="188" height="32" />
        </div>
      </header>
      <StudentProjects />
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Start with one lesson">
        <p>One lesson is all it takes to see your students go from using AI to building with it.</p>
        <Fragment slot="actions">
          <Button href="https://edu.imagilabs.com/" variant="secondary" size="l" arrow>Try imagi free</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
  .steps_image {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .closer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }
</style>
