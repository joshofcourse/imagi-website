---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import Button from '../components/Button.astro';
import SchoolLogos from '../components/SchoolLogos.astro';
import CtaBand from '../components/CtaBand.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="About imagi: Creative AI Literacy for K-12"
  description="Who we are, why we build what we build, and how imagi helps K-12 students learn to create with AI instead of copying from it."
>
  <section class="hero hero--subtle">
    <div class="hero_inner hero_inner--split">
      <div class="hero_text hero_text--left">
        <Badge tone="dark">Our mission</Badge>
        <h1 class="text-display-l">About imagi</h1>
        <div class="hero_lead text-body-l">
          <p>
            imagi is a K-12 learning platform that gives students safe access to real-world AI tools, like Lovable, so they grow from AI
            consumers to future-ready AI creators.
          </p>
        </div>
        <div class="hero_actions hero_actions--left">
          <Button href="/demo" size="l" arrow>Book a demo</Button>
          <Button href="/career" variant="outline" size="l">Join the team</Button>
        </div>
      </div>
      <div class="hero_media">
        <img class="hero_image"
          src="/images/about-imagi/dsc02706_original-1.jpeg"
          alt="The imagi team in matching imagi jackets in their office"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <div class="split">
        <div class="split_text">
          <header class="section-header section-header--left">
            <Badge tone="brand">Since 2018</Badge>
            <h2 class="text-display-s">Founding story</h2>
          </header>
          <p class="text-body-l lead">
            imagi was established by Dora (CEO) and Beatrice (CTO) in 2018, following a user-centered research project conducted at KTH
            University in Stockholm. This reality is what Dora and Beatrice are devoted to changing.
          </p>
          <p class="text-body-l lead">
            Since 2020, our products have been on the market, reaching and supporting groups underrepresented in tech. We are beginning to
            reshape the landscape of the tech industry and engineering education pathways.
          </p>
        </div>
        <div class="split_media">
          <img class="split_image" src="/images/about-imagi/smooth-white-image-outline-1-.png" alt="imagi co-founders Dora and Beatrice" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Our team</Badge>
        <h2 class="text-display-s">The people behind imagi</h2>
        <div class="section-header_intro text-body-l">
          <p>
            We’re an award-winning team across Sweden and the US, united by one belief: every student deserves the opportunity to become an
            AI creator, not just a consumer.
          </p>
        </div>
      </header>
      <div class="grid grid--4">
        <PersonCard name="Dora" role="Co-Founder & CEO" image="/images/about-imagi/dora-imagi.png" />
        <PersonCard name="Beatrice" role="Co-Founder & CTO" image="/images/about-imagi/beatrice-imagi.png" />
        <PersonCard name="Shruti" role="Company Operations Manager" image="/images/about-imagi/shruti.jpeg" />
        <PersonCard name="Steph" role="Director of District Partnership" image="/images/about-imagi/steph.jpeg" />
        <PersonCard name="Janelle" role="Head of Marketing" image="/images/about-imagi/janelle.jpeg" />
        <PersonCard name="Garrett" role="Curriculum and PD Specialist" image="/images/about-imagi/garrett.jpeg" />
        <PersonCard
          name="Naomi"
          role="Educator Success Manager"
          image="/images/about-imagi/naomi.jpeg"
          href="https://www.linkedin.com/in/naomi-kerr-ab7032212/"
        />
        <PersonCard name="Helen" role="Marketing Operations Manager" image="/images/about-imagi/helen.jpeg" />
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="section_inner">
      <SchoolLogos />
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Come join us!">
        <p>
          Are you ready to take the next step in your career? Explore the opportunities waiting for you at imagi. Discover a place where
          your work is meaningful, your contributions are valued, and you can make a lasting impact.
        </p>
        <Fragment slot="actions">
          <Button href="/career" variant="secondary" size="l" arrow>Work with us</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-secondary);
  }
</style>
