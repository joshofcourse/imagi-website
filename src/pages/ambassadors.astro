---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import PersonCard from '../components/PersonCard.astro';
import Button from '../components/Button.astro';
import Testimonial from '../components/Testimonial.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout title="imagi Ambassadors 2026/27" description="Apply to join imagi’s community. Fill in our application form.">
  <section class="hero hero--subtle">
    <div class="hero_inner hero_inner--split">
      <div class="hero_text hero_text--left">
        <Badge tone="dark">Better together</Badge>
        <h1 class="text-display-l">Join the imagi community</h1>
        <div class="hero_lead text-body-l">
          <p>
            The best imagi ideas come from classrooms like yours. This is where you hang out, trade what’s working, get first looks at new
            features, and talk all things AI with educators just like you. Come join us.
          </p>
        </div>
        <div class="hero_actions hero_actions--left">
          <Button href="https://www.facebook.com/groups/imagieducatorcommunity" size="l" arrow external>Join the community</Button>
          <Button href="https://forms.gle/TLJhEZBg3kCivHRr7" variant="outline" size="l" external>Join the waitlist</Button>
        </div>
      </div>
      <div class="hero_media">
        <img class="hero_image"
          src="/images/ambassadors/imagi-community-photo.webp"
          alt="A group of people in imagi caps and jackets cheering together"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Get involved</Badge>
        <h2 class="text-display-s">Three ways to be involved</h2>
      </header>
      <div class="grid grid--3">
        <Card
          band="highlight"
          eyebrow="1"
          title="Community"
          href="https://www.facebook.com/groups/imagieducatorcommunity"
          linkLabel="Join our Facebook group"
          external
        >
          <p>Anyone can be part of our community, wherever you are in the world.</p>
          <p>Learn from others, share your successes, and hear about new product updates.</p>
        </Card>
        <Card
          band="accent"
          eyebrow="2"
          title="Ambassadors"
          href="https://forms.gle/TLJhEZBg3kCivHRr7"
          linkLabel="Join the waitlist"
          external
        >
          <p>
            A select group of imagi users, chosen each year. Join webinars and hackathons, test new features, earn swag and a certificate.
          </p>
          <p>Applications for 2027/28 open soon. Join the waitlist to hear first.</p>
        </Card>
        <Card band="orange" eyebrow="3" title="Ambassador GOLD">
          <p>Awarded to the most dedicated of Ambassadors.</p>
          <p>
            If you’re selected, you’ll get paid opportunities to lead PD sessions, present at conferences, and you’ll receive extra training
            too.
          </p>
          <p>
            GOLD Ambassadors will be chosen later, but if you’re interested, you can opt in for consideration during your Ambassador
            application.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section--subtle" id="cohort">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Ambassadors 26/27</Badge>
        <h2 class="text-display-s">Meet our 2026/27 cohort</h2>
        <div class="section-header_intro text-body-l">
          <p>Real educators building with AI in their classrooms. Read their stories and see what you could be part of.</p>
        </div>
      </header>
      <div class="cohort">
        <PersonCard name="Gigi Mims" image="/images/ambassadors/gieshala_gigi_mims_headshot.jpg" />
        <PersonCard name="Mark Godinez" image="/images/ambassadors/mark_godinez_headshot.jpg" />
        <PersonCard name="Janelle Yearwood" image="/images/ambassadors/janelle-yearwood-headshot.jpg" />
        <PersonCard name="Kelly Powers" image="/images/ambassadors/kelly_powers_headshot.jpg" />
        <PersonCard name="Julie Gonzalez" image="/images/ambassadors/julie_gonzalez_headshot.jpg" />
        <PersonCard name="Samantha Gleisten" image="/images/ambassadors/samantha_gleisten_headshot.png" />
      </div>
      <p class="note text-body-m">…and many more.</p>
      <div class="actions">
        <Button href="https://imagilabs.com/en-us/imagi-ambassadors-26-27" size="l" arrow>Meet the Ambassadors</Button>
        <Button href="https://forms.gle/TLJhEZBg3kCivHRr7" variant="outline" size="l" external>Want in? Join the waitlist</Button>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">In their words</Badge>
        <h2 class="text-display-s">What is it like being an Ambassador?</h2>
      </header>
      <div class="grid grid--3">
        <Testimonial
          tone="subtle"
          name="Rebecca"
          role="STEM Program Manager, Boys & Girls Club of Palm Beach County, Florida · Ambassador 25/26"
        >
          The best part of being in the imagi Ambassador cohort is that you’re blending community, collaboration, and computer science all
          at once.
        </Testimonial>
        <Testimonial
          tone="subtle"
          name="Dr. Sonia"
          role="Computer Science Teacher & CSTA Standards Writer, Massachusetts · Ambassador 25/26"
        >
          I was very honored to be chosen as an imagi Ambassador. There are so many excellent educators out there, so it felt really
          special. I shared the news with everyone: my team, LinkedIn, even my family and friends.
        </Testimonial>
        <Testimonial tone="subtle" name="Gigi" role="Computer Science Teacher, Senatobia School District, Mississippi · Ambassador 25/26">
          The way imagi celebrates its ambassadors makes me proud to wear the button and talk about it. These conversations remind me of my
          why, and I get even more motivated.
        </Testimonial>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Out and about</Badge>
        <h2 class="text-display-s">Ambassadors in action</h2>
      </header>
      <div class="grid grid--3">
        <Card image="/images/ambassadors/1000072719.jpg" imageAlt="imagi Ambassadors at an event booth" title="Meet up at events" />
        <Card
          image="/images/ambassadors/image2.jpeg"
          imageAlt="imagi Ambassadors helping out at a conference"
          title="Help out at conferences"
        />
        <Card
          image="/images/ambassadors/pxl_20260714_235842283.mp-3.jpg"
          imageAlt="imagi Ambassadors learning together"
          title="Learn from others"
        />
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">FAQ</Badge>
        <h2 class="text-display-s">Ambassador FAQs</h2>
      </header>
      <FaqList group="ambassadors" />
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Applications for 2027/28 open soon">
        <p>Join the waitlist to hear first.</p>
        <Fragment slot="actions">
          <Button href="https://forms.gle/TLJhEZBg3kCivHRr7" variant="secondary" size="l" arrow external>Join the waitlist</Button>
          <Button href="https://www.facebook.com/groups/imagieducatorcommunity" variant="inverse" size="l" external
            >Join the community</Button
          >
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .cohort {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .cohort {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .cohort {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .note {
    color: var(--text-secondary);
    text-align: center;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
</style>
