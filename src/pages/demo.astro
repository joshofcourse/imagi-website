---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconDisc from '../components/IconDisc.astro';
import Button from '../components/Button.astro';
import SchoolLogos from '../components/SchoolLogos.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Request a demo"
  description="Discover how imagi can revolutionize coding education at your school and see it in action with our experts."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">Request a demo</Badge>
        <h1 class="text-display-l">Turn your students into AI creators.</h1>
        <div class="hero_lead text-body-l">
          <p>
            Tell us about your classroom, school, or district. We'll put together a plan that gives every student safe access to real-world
            AI tools, starting with Lovable.
          </p>
          <p>Select your location:</p>
        </div>
        <div class="hero_actions">
          <Button href="#us-stephanie" size="l" arrow>United States</Button>
          <Button href="#row-dora" variant="outline" size="l" arrow>Rest of the world</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page" id="us-stephanie">
    <div class="section_inner">
      <div class="formlayout">
        <div class="formlayout_aside">
          <header class="section-header section-header--left">
            <Badge tone="brand">United States</Badge>
            <h2 class="text-display-s">See imagi in action.</h2>
            <div class="section-header_intro text-body-l">
              <p>Your personalized demo by Stephanie from the US.</p>
            </div>
          </header>
          <ul class="checklist checklist--check">
            <li class="checklist_item">Pick a time that suits you</li>
            <li class="checklist_item">Tell us about your classroom, school, or district</li>
            <li class="checklist_item">Get a plan for safe access to real-world AI tools</li>
          </ul>
        </div>
        <div class="formlayout_main">
          <div class="embed">
            <IconDisc icon="calendar" size="l" />
            <p class="text-heading-m">Booking calendar</p>
            <p class="embed_note text-body-s">Placeholder for the HubSpot meetings embed (Stephanie Kortan, US).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--subtle" id="row-dora">
    <div class="section_inner">
      <div class="formlayout">
        <div class="formlayout_aside">
          <header class="section-header section-header--left">
            <Badge tone="brand">Rest of the world</Badge>
            <h2 class="text-display-s">See imagi in action.</h2>
            <div class="section-header_intro text-body-l">
              <p>Your personalized demo by Dora from Europe.</p>
            </div>
          </header>
          <ul class="checklist checklist--check">
            <li class="checklist_item">Pick a time that suits you</li>
            <li class="checklist_item">Tell us about your classroom, school, or district</li>
            <li class="checklist_item">Get a plan for safe access to real-world AI tools</li>
          </ul>
        </div>
        <div class="formlayout_main">
          <div class="embed">
            <IconDisc icon="calendar" size="l" />
            <p class="text-heading-m">Booking calendar</p>
            <p class="embed_note text-body-s">Placeholder for the HubSpot meetings embed (Dora Palfi, country-based demo).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <SchoolLogos />
    </div>
  </section>
</BaseLayout>

<style>
  .embed {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    min-height: 640px;
    padding: var(--space-xl);
    text-align: center;
    background: var(--surface-page);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-m);
  }
  .embed_note {
    color: var(--text-secondary);
    max-width: 320px;
  }
</style>
