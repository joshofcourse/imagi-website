---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import NewsCard from '../components/NewsCard.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import AppMockup from '../components/AppMockup.astro';
import Testimonial from '../components/Testimonial.astro';
import SchoolLogos from '../components/SchoolLogos.astro';
import StudentProjects from '../components/StudentProjects.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Form from '../components/Form.astro';
import Field from '../components/Field.astro';
