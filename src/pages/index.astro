<script>
  // Closing CTA: when it scrolls into view, the student, icons and trails burst out of the green band.
  // The trails are transparent videos that draw themselves; Safari and iPhone (which can't show transparent WebM) get
  // Figma's still images instead, which burst out like the icons. Reduced motion shows the finished picture.
  const cta = document.querySelector<HTMLElement>('[data-homecta]');
  if (cta) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ua = navigator.userAgent;
    const webkitOnly = /Safari\//.test(ua) && !/Chrome\/|Chromium\/|Edg\//.test(ua);
    const useVideo = !reduce && !webkitOnly && document.createElement('video').canPlayType('video/webm; codecs="vp9"') !== '';
    const videos = [...cta.querySelectorAll<HTMLVideoElement>('.homecta_trail-video')];
    // Each trail swaps its still image for its video
    const swap = (on: boolean) => videos.forEach((v) => { v.hidden = !on; const still = v.parentElement?.querySelector<HTMLElement>('.homecta_trail-still'); if (still) still.hidden = on; });
    if (useVideo) swap(true);
    if (!reduce) {
      cta.classList.add('homecta--ready');
      // Start loading the videos a little before the CTA arrives
      const near = new IntersectionObserver(([e]) => { if (e.isIntersecting) { near.disconnect(); if (useVideo) videos.forEach((v) => { v.preload = 'auto'; v.load(); }); } }, { rootMargin: '600px 0px' });
      near.observe(cta);
      // Plays each time the CTA comes into view, and resets once it has fully left the screen, so scrolling back
      // down plays it again.
      let timer = 0;
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && e.intersectionRatio >= 0.4) {
          if (cta.classList.contains('homecta--burst')) return;
          timer = window.setTimeout(() => {
            cta.classList.add('homecta--burst');
            if (useVideo) Promise.all(videos.map((v) => { v.currentTime = 0; return v.play(); })).catch(() => swap(false));
          }, 150);
        } else if (!e.isIntersecting) {
          clearTimeout(timer);
          cta.classList.remove('homecta--burst');
          videos.forEach((v) => { v.pause(); v.currentTime = 0; });
        }
      }, { threshold: [0, 0.4] });
      io.observe(cta);
    }
  }
</script>

<script>
  // Stats band: the green trail draws in as the section scrolls into view (one frame of a 40-frame strip per step),
  // and on desktop the second stat rises 72px in step with it. Reduced motion shows the finished state.
  const statsSection = document.querySelector<HTMLElement>('.homestats');
  const trail = document.querySelector<HTMLCanvasElement>('.homestats_trail');
  if (statsSection && trail) {
    const ctx = trail.getContext('2d');
    const count = Number(trail.dataset.count) || 40;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const strip = new Image();
    let ready = false;
    let shown = -1;
    const draw = (frame: number) => {
      if (!ctx || !ready || frame === shown) return;
      shown = frame;
      ctx.clearRect(0, 0, trail.width, trail.height);
      ctx.drawImage(strip, 0, frame * trail.height, trail.width, trail.height, 0, 0, trail.width, trail.height);
    };
    const update = () => {
      // 0 when the section's top reaches 85% down the window, 1 when it reaches 25%
      const top = statsSection.getBoundingClientRect().top;
      const vh = window.innerHeight;
      const p = reduce ? 1 : Math.min(1, Math.max(0, (vh * 0.85 - top) / (vh * 0.6)));
      statsSection.style.setProperty('--homestats-progress', String(p));
      draw(Math.round(p * (count - 1)));
    };
    let ticking = false;
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } };
    strip.onload = () => { ready = true; shown = -1; update(); };
    strip.src = reduce ? (trail.dataset.still ?? '') : (trail.dataset.frames ?? '');
    if (reduce) strip.onload = () => { ready = true; ctx?.drawImage(strip, 0, 0); statsSection.style.setProperty('--homestats-progress', '1'); };
    else { window.addEventListener('scroll', request, { passive: true }); window.addEventListener('resize', request); update(); }
  }
</script>

<script>
  // How it works (desktop): cards stick in the middle of the window and the next one slides over the top.
  // A card shrinks slightly as the next one covers it, and its green panel lags a little while the card moves.
  const stepCards = [...document.querySelectorAll<HTMLElement>('.homesteps_card')];
  const stepsDesktop = window.matchMedia('(min-width: 1000px)');
  const stepsReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SHRINK = 0.06;    // a covered card ends at 94% size
  const PARALLAX = 120;   // panel starts this many px lower and settles to 0 as the card reaches its resting place
  const LIFT = 160;       // once the card has stuck, the panel keeps rising this far while the next card slides over
  let stepsTicking = false;
  function updateSteps() {
    stepsTicking = false;
    const active = stepsDesktop.matches && !stepsReduce.matches;
    const vh = window.innerHeight;
    // Background: Cream at the top of the section, white by the end, so it runs straight into the white section below
    const stepsSection = document.querySelector<HTMLElement>('.homesteps');
    if (stepsSection) {
      const r = stepsSection.getBoundingClientRect();
      const fade = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)));
      stepsSection.style.setProperty('--homesteps-fade', String(fade));
    }
    stepCards.forEach((card, i) => {
      const panel = card.querySelector<HTMLElement>('.homesteps_panel');
      if (!active) { card.style.removeProperty('--homesteps-scale'); panel?.style.removeProperty('--homesteps-shift'); return; }
      const rect = card.getBoundingClientRect();
      const rest = (vh - rect.height) / 2;               // where the card sticks
      const next = stepCards[i + 1];
      // Shrink while the next card slides over this one
      let covered = 0;
      if (next) covered = Math.min(1, Math.max(0, (vh - next.getBoundingClientRect().top) / (vh - rest)));
      card.style.setProperty('--homesteps-scale', String(1 - covered * SHRINK));
      // Panel: one continuous move from PARALLAX px below its corner to LIFT px above it.
      // The clock is the next card's top edge, which keeps moving the whole time (even while this card is stuck),
      // so there's no pause when this card sticks. It starts when this card's lower half comes into view.
      const start = vh - rect.height * 0.6;                       // this card's top when the panel starts moving
      const gap = parseFloat(getComputedStyle(card.parentElement!).rowGap) || 0;
      let p: number;
      if (next) {
        const clock = next.getBoundingClientRect().top;
        const from = start + rect.height + gap;                   // next card's top when this card is at `start`
        p = Math.min(1, Math.max(0, (from - clock) / Math.max(1, from - rest)));
      } else {
        p = Math.min(1, Math.max(0, (start - rect.top) / Math.max(1, start - rest))) * (PARALLAX / (PARALLAX + LIFT));
      }
      panel?.style.setProperty('--homesteps-shift', `${Math.round(PARALLAX - p * (PARALLAX + LIFT))}px`);
    });
  }
  const requestSteps = () => { if (!stepsTicking) { stepsTicking = true; requestAnimationFrame(updateSteps); } };
  window.addEventListener('scroll', requestSteps, { passive: true });
  window.addEventListener('resize', requestSteps);
  stepsDesktop.addEventListener('change', requestSteps);
  updateSteps();
</script>

<script>
  // TEDx: the play button opens the YouTube video in a modal; Close, Esc or clicking outside stops it and closes.
  const tedxPlay = document.querySelector<HTMLButtonElement>('.tedx_play');
  const tedxModal = document.querySelector<HTMLDialogElement>('.tedx_modal');
  const tedxPlayer = tedxModal?.querySelector<HTMLElement>('.tedx_player');
  if (tedxPlay && tedxModal && tedxPlayer) {
    tedxPlay.addEventListener('click', () => {
      const id = tedxPlay.dataset.video;
      tedxPlayer.innerHTML = `<iframe class="tedx_iframe" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Dora Palfi Osika at TEDx" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
      tedxModal.showModal();
    });
    const close = () => tedxModal.close();
    tedxModal.querySelector('.tedx_close')?.addEventListener('click', close);
    // Click anywhere outside the video frame closes it
    const tedxFrame = tedxModal.querySelector<HTMLElement>('.tedx_modal-frame');
    tedxModal.addEventListener('click', (e) => {
      const r = tedxFrame?.getBoundingClientRect();
      if (!r || e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) close();
    });
    tedxModal.addEventListener('close', () => { tedxPlayer.innerHTML = ''; tedxPlay.focus(); });
  }
</script>

