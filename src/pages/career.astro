---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Careers at imagi"
  description="Help build the tools that teach kids to create with AI. See open roles at imagi and what it’s like to work here."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">We’re hiring</Badge>
        <h1 class="text-display-l">Join the team at imagi</h1>
        <div class="hero_lead text-body-l">
          <p>
            We make the tools and lessons that give students a safe way to create with AI. If that sounds like work worth doing, we’d like
            to meet you.
          </p>
        </div>
        <div class="hero_actions">
          <Button href="https://imagi.homerun.co/" size="l" arrow external>See open roles</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <div class="split">
        <div class="split_text">
          <header class="section-header section-header--left">
            <Badge tone="brand">Our culture</Badge>
            <h2 class="text-display-s">Life at imagi</h2>
          </header>
          <p class="text-body-l lead">
            We are a small, international team with a big mission. We move fast, care deeply about educators and students, and love working
            together. We are re-imagining education for the students growing up in the age of AI.
          </p>
          <Button href="https://www.linkedin.com/company/imagilabs/posts/" variant="outline" size="m" arrow external>Follow us</Button>
        </div>
        <div class="split_media"><img class="split_image" src="/images/career/imagi-3.jpeg" alt="The imagi team" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Careers</Badge>
        <h2 class="text-display-s">Open roles</h2>
      </header>
      <div class="grid grid--2">
        <Card
          icon="code"
          iconTone="highlight"
          title="Founding Engineer (Full-Stack)"
          href="https://imagi.homerun.co/founding-engineer-full-stack/en"
          linkLabel="View the role"
          external
        >
          <Fragment slot="tags">
            <Badge tone="neutral">Full-time</Badge>
            <Badge tone="neutral">Stockholm</Badge>
          </Fragment>
        </Card>
        <Card
          icon="pen-tool"
          iconTone="accent"
          title="Product Designer (UX/UI)"
          href="https://imagi.homerun.co/product-designer-ux-ui/en"
          linkLabel="View the role"
          external
        >
          <Fragment slot="tags">
            <Badge tone="neutral">Full-time</Badge>
            <Badge tone="neutral">Stockholm</Badge>
          </Fragment>
        </Card>
      </div>
      <div class="more">
        <Button href="https://imagi.homerun.co/" variant="outline" size="l" arrow external>Discover more</Button>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Come join us!">
        <p>
          Are you ready to take the next step in your career? Explore the opportunities waiting for you at imagi. Discover a place where
          your work is meaningful, your contributions are valued, and you can make a lasting impact.
        </p>
        <Fragment slot="actions">
          <Button href="https://imagi.homerun.co/" variant="secondary" size="l" arrow external>Work with us</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-secondary);
  }
  .more {
    display: flex;
    justify-content: center;
  }
</style>
