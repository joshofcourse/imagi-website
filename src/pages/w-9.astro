---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Form from '../components/Form.astro';
import Field from '../components/Field.astro';
import CtaBand from '../components/CtaBand.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Request imagi's W-9 and Vendor Documents"
  description="Request imagi's W-9 form and vendor documentation for your school or district's procurement process."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">Vendor documents</Badge>
        <h1 class="text-display-l">Request our W-9</h1>
        <div class="hero_lead text-body-l">
          <p>Fill this in and we'll email the W-9 straight away, along with any other vendor paperwork your school needs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page" id="w-9-form">
    <div class="section_inner">
      <div class="formlayout">
        <div class="formlayout_aside">
          <header class="section-header section-header--left">
            <Badge tone="brand">imagi W-9 and vendor documents</Badge>
            <h2 class="text-display-s">Anything missing?</h2>
            <div class="section-header_intro text-body-l">
              <p>Everything else your procurement team may ask for.</p>
            </div>
          </header>
          <div class="docs">
            <Card icon="shield-half" title="Get a quote" href="/quote" linkLabel="Get a quote">
              <p>A written quote, priced for your student numbers.</p>
            </Card>
            <Card icon="book" title="Vendor registration details" href="/contact" linkLabel="Ask for vendor details">
              <p>Upon request.</p>
            </Card>
            <Card icon="graduation-cap" title="Data privacy agreement" href="/contact" linkLabel="Ask for a DPA">
              <p>Upon request.</p>
            </Card>
          </div>
        </div>
        <div class="formlayout_main">
          <Form submitLabel="Send me the W-9">
            <Field label="First name" name="firstname" required />
            <Field label="Last name" name="lastname" required />
            <Field label="Email" name="email" type="email" required full />
            <Field
              label="Profession"
              name="profession"
              type="select"
              options={[
                'Administrator',
                'Coach',
                'Coordinator',
                'Curriculum Specialist',
                'District Administrator',
                'Gifted and Talented',
                'Guardian',
                'Homeschool',
                'Librarian/Media Specialist',
                'Observer',
                'Superintendent/Assistant Superintendent',
                'Teacher',
                'Tech or STEM Coordinator',
                'Other',
              ]}
              required
            />
            <Field label="Phone number" name="phone" type="tel" />
            <Field label="Country" name="country" required full />
          </Form>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Need something else?">
        <p>Contact us directly and we will make sure your request reaches the right person.</p>
        <Fragment slot="actions">
          <Button href="/contact" variant="secondary" size="l" arrow>Contact us</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .docs {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }
</style>
