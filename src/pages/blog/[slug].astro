---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => p.data.published);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <section class="posthero">
      <div class="container">
        <div class="posthero_inner">
          <div class="posthero_tags">{post.data.tags.map((t) => <Badge tone="neutral">{t}</Badge>)}</div>
          <h1 class="text-display-l">{post.data.title}</h1>
          <p class="posthero_meta text-body-s-medium">
            By <a class="posthero_author" href={`/blog/author/${post.data.author.id}`}>{author?.data.name}</a> · {date}
          </p>
          <img class="posthero_image" src={post.data.image} alt={post.data.imageAlt} />
        </div>
      </div>
    </section>

    <section class="section section--page section--tight postbody">
      <div class="section_inner">
        <div class="prose text-body-m">
          <Content />
        </div>
      </div>
    </section>
  </article>

  <section class="section section--subtle">
    <div class="section_inner">
      <header class="section-header">
        <h2 class="text-display-s">More stories</h2>
      </header>
      <PostList exclude={post.id} limit={3} />
    </div>
  </section>
</BaseLayout>

<style>
  .posthero {
    background: var(--surface-subtle);
    padding-block: calc(var(--header) + var(--hero-padding-top)) 0;
  }
  .posthero_inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
    max-width: 960px;
    margin-inline: auto;
  }
  .posthero_tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
  }
  .posthero_meta {
    color: var(--text-secondary);
  }
  .posthero_author {
    color: var(--text-primary);
  }
  .posthero_image {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-top: var(--space-lg);
    margin-bottom: calc(var(--space-3xl) * -1);
    box-shadow: var(--shadow-m);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  /* The section after the header clears the overlapping image */
  .postbody {
    padding-top: calc(var(--space-3xl) + var(--space-2xl));
  }
</style>
