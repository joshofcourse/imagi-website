---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { author: author.id }, props: { author } }));
}

const { author } = Astro.props;
const { Content } = await render(author);
import Badge from '../../../components/Badge.astro';
---

<BaseLayout title={`Posts by ${author.data.name}`}>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">Author</Badge>
        <h1 class="text-display-l">{author.data.name}</h1>
        <div class="hero_lead text-body-l">
          {author.data.role && <p>{author.data.role}</p>}
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <PostList author={author.id} />
    </div>
  </section>
</BaseLayout>
