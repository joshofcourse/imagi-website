---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Form from '../components/Form.astro';
import Field from '../components/Field.astro';
import SchoolLogos from '../components/SchoolLogos.astro';
import StudentProjects from '../components/StudentProjects.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Hour of AI Lesson Plans, Free for K-12 Teachers"
  description="Free 1-hour AI coding lessons for grades 3-12. Ready-to-teach slides, about 10 minutes of prep, no coding experience needed. Built with Lovable and OpenAI."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">Hour of AI · From Nov 16, 2026</Badge>
        <h1 class="text-display-l">Their first hour as AI creators</h1>
        <div class="hero_lead text-body-l">
          <p>
            In one class period, students direct Lovable to build something real, question what it makes, and make it their own, safely
            inside imagi Edu. No coding experience needed, for you or your students.
          </p>
        </div>
        <div class="hero_meta">
          <Badge tone="neutral" size="m">60 minutes</Badge>
          <Badge tone="neutral" size="m">Grades 3–12</Badge>
          <Badge tone="neutral" size="m">Works on Chromebooks</Badge>
        </div>
        <div class="hero_actions">
          <Button href="https://edu.imagilabs.com/" size="l" arrow>Get started in imagi Edu</Button>
          <Button href="#reserve" variant="outline" size="l">Reserve free access</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <header class="section-header">
        <Badge tone="brand">Three activities</Badge>
        <h2 class="text-display-s">Pick the one hour that fits your class.</h2>
        <div class="section-header_intro text-body-l">
          <p>
            Each activity comes with a lesson plan, teacher slides and a setup guide. Free for teachers, nothing to download, no student
            accounts needed.
          </p>
        </div>
      </header>
      <div class="grid grid--3">
        <Card
          band="highlight"
          eyebrow="Python"
          title="Creative Coding with Python and AI"
          href="https://info.imagilabs.com/python"
          linkLabel="See the activity"
          external
        >
          <Fragment slot="tags">
            <Badge tone="neutral">Grades 3–8</Badge>
            <Badge tone="neutral">1 hour</Badge>
            <Badge tone="neutral">Beginner</Badge>
          </Fragment>
          <p>
            Students design pixel art and animations while learning loops and variables, with an AI Debugging Buddy that helps them fix
            their code.
          </p>
        </Card>
        <Card
          band="orange"
          eyebrow="Vibe coding"
          title="Build Your First Game Using AI"
          href="https://info.imagilabs.com/game"
          linkLabel="See the activity"
          external
        >
          <Fragment slot="tags">
            <Badge tone="brand">2,500 free credits</Badge>
            <Badge tone="neutral">Grades 6–12</Badge>
            <Badge tone="neutral">1 hour</Badge>
            <Badge tone="neutral">Beginner</Badge>
          </Fragment>
          <p>
            Students describe a game in plain language, build it with Lovable inside imagi Edu, then publish and share it. The best place to
            start with AI building.
          </p>
        </Card>
        <Card
          band="accent"
          eyebrow="Vibe coding"
          title="Build Your Dream School"
          href="https://info.imagilabs.com/dreamschool"
          linkLabel="See the activity"
          external
        >
          <Fragment slot="tags">
            <Badge tone="brand">2,500 free credits</Badge>
            <Badge tone="neutral">Grade 6+</Badge>
            <Badge tone="neutral">60 min</Badge>
            <Badge tone="neutral">Intermediate</Badge>
          </Fragment>
          <p>
            Students imagine their dream school, build an app with AI that solves a real school problem, and pitch it to their school
            leader. Best after the game activity.
          </p>
        </Card>
      </div>
      <p class="note text-body-s">
        Teachers who sign up during Hour of AI get 2,500 bonus Lovable credits for the two vibe coding activities, enough for a whole class.
        Credits expire December 31, 2026; published student projects stay viewable.
      </p>
    </div>
  </section>

  <section class="section section--subtle" id="reserve">
    <div class="section_inner section_inner--narrow">
      <header class="section-header">
        <Badge tone="brand">Hour of AI 2026</Badge>
        <h2 class="text-display-s">One hour. Every student walks out with a tool, app, or website they built with AI.</h2>
      </header>
      <Form submitLabel="Reserve free access for your class">
        <Field label="First name" name="firstname" required />
        <Field label="Last name" name="lastname" required />
        <Field label="School email" name="email" type="email" placeholder="Valid education email required" required full />
        <Field
          label="Profession"
          name="profession"
          type="select"
          options={[
            'Teacher',
            'Administrator',
            'Coordinator',
            'Curriculum Specialist',
            'District Administrator',
            'Librarian/Media Specialist',
            'Tech or STEM Coordinator',
            'Other',
          ]}
          required
        />
        <Field label="School or district name" name="company" required />
        <Field label="Country" name="country" required />
        <Field label="How did you hear about us?" name="how_did_you_hear_about_us" required />
      </Form>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <SchoolLogos />
    </div>
  </section>

  <section class="section section--muted">
    <div class="section_inner">
      <header class="projects-header">
        <div class="projects-header_text">
          <h2 class="text-display-s">Real student projects</h2>
          <p class="projects-header_intro text-body-l">Try some of our favorite student-coded projects made inside the imagi tool.</p>
        </div>
        <div class="madewith">
          <p class="madewith_label text-body-s-medium">Made with</p>
          <img class="madewith_logo" src="/brand/lovable-wordmark-dark.svg" alt="Lovable" width="188" height="32" />
        </div>
      </header>
      <StudentProjects />
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Get your free teacher account">
        <p>Sign up, pick a project, and see what your students do with it.</p>
        <Fragment slot="actions">
          <Button href="https://edu.imagilabs.com/" variant="secondary" size="l" arrow>Try imagi free</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    color: var(--text-secondary);
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
  }
</style>
