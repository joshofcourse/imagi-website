---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Testimonial from '../components/Testimonial.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="AI Professional Development for Teachers | imagi"
  description="Practical AI training for K-12 teachers. Leave with lessons you can teach, not slides you’ll never open again. Available for individuals, schools, and districts."
>
  <section class="hero hero--subtle">
    <div class="hero_inner">
      <div class="hero_text">
        <Badge tone="dark">PD training</Badge>
        <h1 class="text-display-l">Bring AI into your classroom with confidence.</h1>
        <div class="hero_lead text-body-l">
          <p>
            A live, hands-on session with an imagi educator, online or in person. Teachers build something real with Lovable and leave ready
            to teach it.
          </p>
        </div>
        <div class="hero_meta">
          <Badge tone="neutral" size="m">1 · Learn with an imagi educator</Badge>
          <Badge tone="neutral" size="m">2 · Build something real with Lovable</Badge>
          <Badge tone="neutral" size="m">3 · Teach it to your students</Badge>
        </div>
        <div class="hero_actions">
          <Button href="/quote" size="l" arrow>Get quote</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <header class="section-header">
        <h2 class="text-display-s">Leave ready to teach your students to create and build with AI</h2>
        <div class="section-header_intro text-body-l">
          <p>
            You don't need to be an AI expert. In one session you'll design and build the same activities your students will, and leave with
            everything ready for your classroom. Live, hands-on, online or in person.
          </p>
        </div>
      </header>
      <div class="grid grid--3">
        <Card icon="shield-half" title="Safe AI in your classroom">
          <p>Learn what to open up and what to keep closed, so your students build with AI instead of copying answers from it.</p>
        </Card>
        <Card icon="book" iconTone="accent" title="Lessons ready for Monday">
          <p>You leave with classroom-ready activities, slides and learning outcomes. Nothing to build from scratch on a Sunday night.</p>
        </Card>
        <Card icon="graduation-cap" iconTone="brand" title="Confidence at every level">
          <p>
            Most teachers arrive having never written a line of code. You'll write some, watch it run, and find out Python is friendlier
            than it looks.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="section_inner">
      <header class="section-header">
        <h2 class="text-display-s">Pick the session that fits your school</h2>
        <div class="section-header_intro text-body-l">
          <p>Two ways, both live with an imagi educator. Tell us who is coming and we'll shape the session around them.</p>
        </div>
      </header>
      <div class="grid grid--2">
        <Card band="highlight" icon="tablet" iconTone="brand" title="Online" href="/quote" linkLabel="Get a quote">
          <p>
            30 minutes to 3 hours, and it fits inside the working day. Good for a single department, a fast start, or a taste of imagi
            before you commit to more.
          </p>
        </Card>
        <Card band="accent" icon="user" iconTone="brand" title="In person" href="/quote" linkLabel="Get a quote">
          <p>A half day or a full day at your school. Better for larger groups and more hands-on time with your team.</p>
        </Card>
      </div>
      <div class="grid grid--3">
        <Card icon="circle-arrow-right" iconTone="muted" title="No experience required">
          <p>
            Whether your teachers are brand new to AI or already building with it, we adjust the session to match. Beginners get the basics.
            Experienced teachers go further.
          </p>
        </Card>
        <Card icon="circle-arrow-right" iconTone="muted" title="Support doesn't end with the session">
          <p>Leave with ongoing access to resources and support, not just a one-time training.</p>
        </Card>
        <Card icon="circle-arrow-right" iconTone="muted" title="More than a demo">
          <p>
            Sessions include hands-on building and real cross-curricular ideas, so AI creation fits into any subject your teachers already
            teach, not just a standalone tech class.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="section_inner">
      <div class="grid grid--3">
        <Testimonial name="Kelly Powers" role="CS Teacher, Private School - NY, USA" image="/images/computer-science/kelly-p.jpeg">
          You have something special - a rigorous and engaging curriculum where students are passionate about creating projects with code
          and sharing those projects.
        </Testimonial>
        <Testimonial name="Mr. Godinez" role="Academy of IT, Florida" image="/images/computer-science/1619653945474.jpeg">
          Through imagi, students learn that their first attempt doesn't always work, and that's the point. It teaches them to refine their
          instructions and think critically about coding and AI.
        </Testimonial>
        <Testimonial
          name="Paige Besthoff"
          role="Computer Science Teacher, Public School - Spotswood, NJ"
          image="/images/computer-science/1644789063101.jpeg"
        >
          You don’t have to know anything about teaching computer science. After the PD our art, math and reading teachers were all able to
          incorporate the imagi platform into their curriculum. There are so many cross-curricular opportunities available.
        </Testimonial>
      </div>
    </div>
  </section>

  <section class="section section--page">
    <div class="section_inner">
      <CtaBand title="Train one teacher or your whole staff">
        <p>Tell us your setup and we’ll suggest what fits.</p>
        <Fragment slot="actions">
          <Button href="/quote" variant="secondary" size="l" arrow>Book training</Button>
        </Fragment>
      </CtaBand>
    </div>
  </section>
</BaseLayout>
