---
/**
 * Compact person card: round photo, name and role. Use inside <Grid cols={4}>.
 * `href` (optional) links the name, e.g. to a LinkedIn profile.
 */
interface Props {
  name: string;
  role?: string;
  image: string;
  href?: string;
  tone?: 'page' | 'subtle' | 'muted';
}

const { name, role, image, href, tone = 'page' } = Astro.props;
---

<article class:list={['person', `person--${tone}`]}>
  <img class="person_photo" src={image} alt={name} loading="lazy" />
  <div class="person_text">
    <h3 class="text-heading-s">
      {href ? <a href={href} target="_blank" rel="noopener">{name}</a> : name}
    </h3>
    {role && <p class="person_role text-body-s">{role}</p>}
  </div>
</article>

<style>
  .person { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-md); padding: var(--space-xl) var(--space-lg); border-radius: var(--radius-lg); box-shadow: var(--shadow-s); height: 100%; }
  .person--page { background: var(--surface-page); }
  .person--subtle { background: var(--surface-subtle); }
  .person--muted { background: var(--surface-muted); }
  .person_photo { width: 120px; height: 120px; border-radius: var(--radius-pill); object-fit: cover; background: var(--surface-muted); }
  .person_text { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .person_text a { color: inherit; text-decoration: none; }
  .person_text a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .person_role { color: var(--text-secondary); }
</style>
