---
/**
 * Press coverage cards from the press collection (src/content/press/*.md), sorted by `order`.
 * Add, edit or reorder articles in the Markdown files, not here.
 */
import { getCollection } from 'astro:content';
import Grid from './Grid.astro';
import Card from './Card.astro';

interface Props {
  cols?: 2 | 3 | 4;
  linkLabel?: string;
}

const { cols = 3, linkLabel = 'Read the article' } = Astro.props;
const items = (await getCollection('press')).sort((a, b) => a.data.order - b.data.order);
---

<Grid cols={cols}>
  {items.map((item) => (
    <Card title={item.data.title} image={item.data.image} imageAlt={item.data.title} href={item.data.url} linkLabel={linkLabel} external>
      <p>{item.data.summary}</p>
    </Card>
  ))}
</Grid>
