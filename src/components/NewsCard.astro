---
/**
 * News / story card (Figma: News Card): a 16:9 photo with 16px corners, a Heading M title, a one-line excerpt that ends
 * in "…", and a Moss "Read →" link. The whole card is clickable.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  image: string;
  imageAlt?: string;
  href: string;
  linkLabel?: string;
}

const { title, text, image, imageAlt = '', href, linkLabel = 'Read' } = Astro.props;
---

<article class="newscard" data-figma="Site/NewsCard">
  <img class="newscard_image" src={image} alt={imageAlt} loading="lazy" />
  <div class="newscard_body">
    <div class="newscard_content">
      <h3 class="newscard_title text-heading-m"><a class="newscard_cover-link" href={href}>{title}</a></h3>
      <p class="newscard_text text-body-s" title={text}>{text}</p>
    </div>
    <span class="newscard_link text-body-s-medium" aria-hidden="true">{linkLabel} <Icon name="arrow-right" size={18} /></span>
  </div>
</article>

<style>
  .newscard { position: relative; display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
  .newscard_image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-md); }
  .newscard_body { display: flex; flex-direction: column; gap: var(--space-xl); padding-right: var(--space-md); flex: 1; }
  .newscard_content { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .newscard_title { color: var(--text-primary); margin: 0; }
  /* The title link covers the whole card, so the card is one click target */
  .newscard_cover-link { color: inherit; text-decoration: none; }
  .newscard_cover-link::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-md); }
  .newscard_cover-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* One line, cut off with "…" */
  .newscard_text { color: var(--text-primary); opacity: 0.75; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .newscard_link { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-moss); margin-top: auto; }
</style>
