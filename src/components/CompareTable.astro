---
/**
 * Plan comparison table. Pass the column headings as `columns`; put <tr> rows in the slot:
 * <tr><th scope="row">Feature</th><td>…</td>…</tr>. Use <Icon name="check" label="Included" />
 * and <Icon name="x" label="Not included" /> for yes/no cells.
 */
interface Props {
  columns: string[];
  caption?: string;
}

const { columns, caption } = Astro.props;
---

<div class="comparetable">
  <table class="comparetable_table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        {columns.map((c, i) => <th scope="col" class:list={['comparetable_th', 'text-body-s-medium', { 'comparetable_th--first': i === 0 }]}>{c}</th>)}
      </tr>
    </thead>
    <tbody class="text-body-s"><slot /></tbody>
  </table>
</div>

<style>
  .comparetable { overflow-x: auto; background: var(--surface-page); border-radius: var(--radius-lg); box-shadow: var(--shadow-s); }
  .comparetable_table { width: 100%; min-width: 720px; border-collapse: collapse; }
  /* Column headings */
  .comparetable_th { padding: var(--space-md) var(--space-lg); text-align: center; border-bottom: var(--border-thin) solid var(--border-default); vertical-align: middle; background: var(--surface-highlight); }
  .comparetable_th--first { text-align: left; font-weight: 500; }
  /* The rows come from the page through the slot, so they're styled with :global */
  :global(.comparetable td) { padding: var(--space-md) var(--space-lg); text-align: center; border-bottom: var(--border-thin) solid var(--border-default); vertical-align: middle; }
  /* Row labels (<th scope="row">) */
  :global(.comparetable tbody th) { padding: var(--space-md) var(--space-lg); text-align: left; border-bottom: var(--border-thin) solid var(--border-default); vertical-align: middle; font-weight: 500; }
  /* No line under the last row */
  :global(.comparetable tbody tr:last-child > *) { border-bottom: 0; }
  /* Centre the check / x icons */
  :global(.comparetable td .icon) { margin-inline: auto; }
  :global(.comparetable td .icon[aria-label='Not included']) { color: var(--text-secondary); }
</style>
