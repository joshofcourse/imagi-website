---
/** Site footer: 3D artwork, "Tools for Schools" logo, four link columns, social links and the legal row. Edit the columns below. Artwork lives in public/images/footer/. */
import Icon from './Icon.astro';

const columns = [
  {
    title: 'For Schools',
    links: [
      { label: 'Get started', href: '/get-started' },
      { label: 'Hour of AI', href: '/hour-of-ai' },
      { label: 'PD Training', href: '/pd-training' },
      { label: 'Computer Science', href: '/computer-science' },
      { label: 'Resources', href: '/resources' },
    ],
  },
  {
    title: 'For Families',
    links: [{ label: 'imagiCharm', href: '/for-parents' }],
  },
  {
    title: 'Company',
    links: [
      { label: 'Log in | Try free', href: 'https://edu.imagilabs.com/' },
      { label: 'Ambassadors', href: '/ambassadors' },
      { label: 'About us', href: '/about-imagi' },
      { label: 'Press', href: '/press' },
      { label: 'Careers', href: '/career' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Contact us', href: '/contact' },
      { label: 'Get a quote', href: '/quote' },
      { label: 'Request W-9', href: '/w-9' },
      { label: 'Safety', href: '/safety' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
];

const social = [
  { icon: 'facebook', label: 'Facebook', href: 'https://www.facebook.com/imagilabs' },
  { icon: 'x-social', label: 'X', href: 'https://x.com/imagilabs' },
  { icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/imagilabs/' },
  { icon: 'youtube', label: 'YouTube', href: 'https://www.youtube.com/@imagi-channel' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/company/imagilabs/' },
];

const legal = [
  { label: 'Terms of Service', href: '/terms-of-service' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Cookie Policy', href: '/cookie-policy' },
  { label: 'Terms of Sale', href: '/terms-of-sale' },
];
---

<footer class="footer" data-figma="Site/Footer">
  <img class="footer_art footer_art--left" src="/images/footer/footer-art-left.webp" alt="" loading="lazy" />
  <img class="footer_art footer_art--right" src="/images/footer/footer-art-right.webp" alt="" loading="lazy" />
  <div class="container">
    <div class="footer_inner">
      <a class="footer_logo" href="/" aria-label="imagi home">
        <img class="footer_logo-img" src="/images/footer/imagi-tools-for-schools.svg" alt="imagi — Tools for Schools" width="405" height="153" />
      </a>
      <div class="footer_main">
        <nav class="footer_columns" aria-label="Footer">
          {columns.map((col) => (
            <div>
              <p class="text-body-s footer_heading">{col.title}</p>
              <ul class="footer_links">
                {col.links.map((link) => <li><a class="footer_link text-body-s" href={link.href}>{link.label}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
        <ul class="footer_social">
          {social.map((s) => (
            <li><a class="footer_social-link" href={s.href} target="_blank" rel="noopener"><Icon name={s.icon} size={20} label={s.label} /></a></li>
          ))}
        </ul>
        <div class="footer_bottom text-body-xs-medium">
          <p class="footer_copyright">© 2026 imagilabs. <a class="footer_bottom-link" href="/privacy-policy">Do not sell my personal information</a></p>
          <ul class="footer_legal">
            {legal.map((link) => <li><a class="footer_bottom-link" href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Dark gradient (Ink top right → Moss bottom left), 3D artwork in the top corners, logo lockup centred */
  .footer {
    position: relative; overflow: hidden;
    background: linear-gradient(to bottom left, var(--color-black), var(--color-moss));
    color: var(--text-inverse);
    /* Tucked up behind main's rounded corners, so the gradient shows around them */
    margin-top: calc(var(--radius-lg) * -1);
    padding-block: calc(var(--space-4xl) + var(--radius-lg)) var(--space-xl);
    will-change: transform;
  }
  /* Phones: the logo drops below the artwork instead of overlapping */
  @media (max-width: 699px) {
    .footer { padding-top: calc(var(--space-4xl) + var(--space-3xl) + var(--radius-lg)); }
  }

  .footer_art { position: absolute; pointer-events: none; height: auto; }
  .footer_art--left { left: 0; top: var(--radius-lg); width: clamp(180px, 32vw, 463px); }
  @media (max-width: 699px) {
    .footer_art--left { width: 140px; }
  }
  .footer_art--right { right: 0; top: calc(clamp(16px, 2.7vw, 39px) + var(--radius-lg)); width: clamp(160px, 29vw, 418px); }
  @media (max-width: 699px) {
    .footer_art--right { width: 130px; top: calc(var(--space-md) + var(--radius-lg)); }
  }

  .footer_inner { position: relative; display: flex; flex-direction: column; gap: clamp(var(--space-3xl), 14vw, calc(var(--space-4xl) * 2)); }
  .footer_logo { align-self: center; display: block; padding: var(--space-xs); text-decoration: none; color: inherit; }
  .footer_logo:hover { text-decoration: underline; text-underline-offset: 3px; }
  .footer_logo-img { display: block; width: clamp(200px, 28vw, 405px); height: auto; }
  .footer_main { display: flex; flex-direction: column; gap: var(--space-xl); }

  /* Link columns */
  .footer_columns { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl) var(--space-2xl); }
  @media (min-width: 900px) {
    .footer_columns { grid-template-columns: repeat(4, 220px); }
  }
  .footer_heading { opacity: 0.5; }
  .footer_links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-xs); margin-top: var(--space-md); }
  .footer_link { text-decoration: none; color: inherit; }
  .footer_link:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Social icons: round Moss buttons, Zest on hover */
  .footer_social { list-style: none; padding: 0; margin: 0; display: flex; gap: var(--space-sm); }
  .footer_social-link { text-decoration: none; color: inherit; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-pill); background: var(--color-moss); }
  .footer_social-link:hover { text-underline-offset: 3px; background: var(--color-zest); color: var(--text-primary); text-decoration: none; }

  /* Legal row */
  .footer_bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-md); padding-top: var(--space-xl); border-top: var(--border-thin) solid rgb(255 255 255 / 0.15); }
  .footer_copyright { opacity: 0.6; }
  .footer_legal { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-md) var(--space-xl); }
  .footer_bottom-link { text-decoration: none; color: inherit; }
  .footer_bottom-link:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  // Slight parallax reveal: while the footer scrolls into view it trails behind the page,
  // starting tucked up under the content and settling into place once fully visible.
  const footer = document.querySelector<HTMLElement>('.footer');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const STRENGTH = 0.35; // share of the footer's height it lags by when it first appears
  let ticking = false;
  function update() {
    ticking = false;
    if (!footer) return;
    if (reduce.matches) { footer.style.transform = ''; return; }
    footer.style.transform = '';
    const rect = footer.getBoundingClientRect();
    const hidden = Math.min(Math.max(rect.bottom - window.innerHeight, 0), rect.height);
    footer.style.transform = hidden >= 1 ? `translate3d(0, ${Math.round(-hidden * STRENGTH)}px, 0)` : '';
  }
  function request() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
  window.addEventListener('scroll', request, { passive: true });
  window.addEventListener('resize', request);
  reduce.addEventListener('change', request);
  update();
</script>
