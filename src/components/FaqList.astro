---
/**
 * Accordion of questions from the FAQs collection (src/content/faqs/<group>/).
 * Pass the group name, e.g. <FaqList group="pricing" />.
 */
import { getCollection, render } from 'astro:content';

interface Props {
  group: string;
}

const { group } = Astro.props;
const items = (await getCollection('faqs', (f) => f.data.group === group)).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
---

<div class="faqlist">
  {rendered.map(({ item, Content }) => (
    <details class="faq">
      <summary class="text-heading-s">
        {item.data.question}
        <span class="faq_mark" aria-hidden="true" />
      </summary>
      <div class="faq_answer text-body-m"><Content /></div>
    </details>
  ))}
</div>

<style>
  .faqlist { display: flex; flex-direction: column; gap: var(--space-sm); width: 100%; max-width: 860px; margin-inline: auto; }
  .faq { background: var(--surface-page); border-radius: var(--radius-md); box-shadow: var(--shadow-s); }
  :global(.section--page) .faq { background: var(--surface-subtle); box-shadow: none; }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .faq_mark { position: relative; flex: none; width: 32px; height: 32px; border-radius: var(--radius-pill); background: var(--surface-highlight); }
  .faq_mark::before, .faq_mark::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: 12px; height: 2px; background: currentColor; translate: -50% -50%; transition: rotate 0.2s; }
  .faq_mark::after { rotate: 90deg; }
  .faq[open] .faq_mark::after { rotate: 0deg; }
  .faq_answer { padding: 0 var(--space-lg) var(--space-lg); color: var(--text-secondary); display: flex; flex-direction: column; gap: var(--space-sm); }
  .faq_answer :global(a) { color: var(--text-primary); }
  .faq_answer :global(ul), .faq_answer :global(ol) { padding-left: 1.25em; display: flex; flex-direction: column; gap: var(--space-2xs); }
</style>
