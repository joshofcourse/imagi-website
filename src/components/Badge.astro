---
/** Small pill label: eyebrows, tags and status chips. Matches the Figma Badge component. */
interface Props {
  tone?: 'brand' | 'neutral' | 'dark' | 'accent' | 'outline';
  size?: 's' | 'm';
}

const { tone = 'brand', size = 's' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, `badge--${size}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    border-radius: var(--radius-pill);
    font-weight: 500;
    white-space: nowrap;
  }
  .badge--s { padding: var(--space-2xs) var(--space-sm); font-size: var(--label-s); line-height: var(--label-s-lh); }
  .badge--m { padding: 6px var(--space-md); font-size: var(--label-m); line-height: var(--label-m-lh); }
  .badge--brand { background: var(--surface-highlight); color: var(--text-primary); }
  .badge--neutral { background: var(--surface-muted); color: var(--text-primary); }
  .badge--dark { background: var(--surface-dark); color: var(--text-inverse); }
  .badge--accent { background: var(--surface-accent); color: var(--text-primary); }
  .badge--outline { box-shadow: inset 0 0 0 var(--border-thin) var(--border-strong); color: var(--text-primary); }
</style>
