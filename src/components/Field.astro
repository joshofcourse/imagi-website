---
/** One form field with its label. Use inside <Form>. `full` spans both columns. */
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'textarea' | 'select' | 'checkboxes';
  required?: boolean;
  placeholder?: string;
  /** Options for type="select" or "checkboxes" (tick any number) */
  options?: string[];
  full?: boolean;
}

const { label, name, type = 'text', required = false, placeholder, options = [], full = false } = Astro.props;
const id = `field-${name}`;
---

<div class:list={['field', { 'field--full': full || type === 'textarea' || type === 'checkboxes' }]}>
  {type === 'checkboxes' ? (
    <fieldset class="field_group">
      <legend class="text-label-m">{label}{required && <span aria-hidden="true">*</span>}</legend>
      <div class="field_options">
        {options.map((o) => (
          <label class="field_check text-body-s"><input type="checkbox" name={name} value={o} /> <span>{o}</span></label>
        ))}
      </div>
    </fieldset>
  ) : (
    <label class="text-label-m" for={id}>{label}{required && <span aria-hidden="true">*</span>}</label>
  )}
  {type === 'checkboxes' ? null : type === 'textarea' ? (
    <textarea id={id} name={name} required={required} placeholder={placeholder} rows="5" />
  ) : type === 'select' ? (
    <select id={id} name={name} required={required}>
      <option value="">Please select</option>
      {options.map((o) => <option>{o}</option>)}
    </select>
  ) : (
    <input id={id} name={name} type={type} required={required} placeholder={placeholder} />
  )}
</div>

<style>
  .field { display: flex; flex-direction: column; gap: var(--space-xs); }
  .field--full { grid-column: 1 / -1; }
  input, select, textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    min-height: 48px;
    border: var(--border-thin) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-page);
    font-size: var(--body-s);
  }
  textarea { resize: vertical; }
  .field_group { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .field_options { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-xs) var(--space-lg); }
  .field_check { display: flex; gap: var(--space-xs); align-items: flex-start; cursor: pointer; }
  .field_check input { width: 18px; height: 18px; min-height: 0; padding: 0; flex: none; margin-top: 2px; accent-color: var(--action-primary); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--border-focus); box-shadow: 0 0 0 3px rgb(128 220 30 / 0.25); }
</style>
